{
	"info": {
		"_postman_id": "erp-crm-operations-portal-v1",
		"name": "Mini ERP + CRM Operations Portal API",
		"description": "Postman Collection covering Authentication (RBAC), Customer CRM, Product Inventory & Stock Logs, and Sales Challans with atomic stock validation.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "POST /auth/login (Admin)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@erp.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "POST /auth/login (Sales)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"sales@erp.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "GET /auth/me",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwtToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/auth/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "me"]
						}
					}
				}
			]
		},
		{
			"name": "2. Customer CRM",
			"item": [
				{
					"name": "GET /customers (List & Search)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwtToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/customers?search=Apex&status=Active",
							"host": ["{{baseUrl}}"],
							"path": ["api", "customers"],
							"query": [
								{ "key": "search", "value": "Apex" },
								{ "key": "status", "value": "Active" }
							]
						}
					}
				},
				{
					"name": "POST /customers (Create Customer)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Rohan Kapoor\",\n  \"mobile\": \"+91 98989 12121\",\n  \"email\": \"rohan@kapoortraders.com\",\n  \"businessName\": \"Kapoor Industrial Traders\",\n  \"gstNumber\": \"27AAACK1122D1Z4\",\n  \"type\": \"Wholesale\",\n  \"address\": \"Sector 18, Vashi, Navi Mumbai - 400703\",\n  \"status\": \"Lead\",\n  \"notes\": \"Inquired about industrial bolt supplies.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/customers",
							"host": ["{{baseUrl}}"],
							"path": ["api", "customers"]
						}
					}
				},
				{
					"name": "POST /customers/:id/notes (Add Follow-up Note)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"note\": \"Discussed Q3 pricing structure over call. Agreed to send formal sample pack.\",\n  \"followUpDate\": \"2026-08-15\",\n  \"newStatus\": \"Active\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/customers/CUSTOMER_ID/notes",
							"host": ["{{baseUrl}}"],
							"path": ["api", "customers", "CUSTOMER_ID", "notes"]
						}
					}
				}
			]
		},
		{
			"name": "3. Products & Stock Logs",
			"item": [
				{
					"name": "GET /products (Catalog & Low Stock Filter)",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
						"url": {
							"raw": "{{baseUrl}}/api/products?lowStock=true",
							"host": ["{{baseUrl}}"],
							"path": ["api", "products"],
							"query": [{ "key": "lowStock", "value": "true" }]
						}
					}
				},
				{
					"name": "POST /products/:id/adjust-stock (Manual Movement)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"quantityChanged\": 50,\n  \"movementType\": \"IN\",\n  \"reason\": \"Bulk Restock Shipment Recv PO-9002\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/products/PRODUCT_ID/adjust-stock",
							"host": ["{{baseUrl}}"],
							"path": ["api", "products", "PRODUCT_ID", "adjust-stock"]
						}
					}
				},
				{
					"name": "GET /products/stock-logs",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
						"url": {
							"raw": "{{baseUrl}}/api/products/stock-logs",
							"host": ["{{baseUrl}}"],
							"path": ["api", "products", "stock-logs"]
						}
					}
				}
			]
		},
		{
			"name": "4. Sales Challans",
			"item": [
				{
					"name": "POST /challans (Create Confirmed Challan & Deduct Stock)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerId\": \"CUSTOMER_ID\",\n  \"status\": \"Confirmed\",\n  \"items\": [\n    {\n      \"productId\": \"PRODUCT_ID\",\n      \"quantity\": 5\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/challans",
							"host": ["{{baseUrl}}"],
							"path": ["api", "challans"]
						}
					}
				},
				{
					"name": "PATCH /challans/:id/status (Confirm Draft)",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"Confirmed\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/challans/CHALLAN_ID/status",
							"host": ["{{baseUrl}}"],
							"path": ["api", "challans", "CHALLAN_ID", "status"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000"
		},
		{
			"key": "jwtToken",
			"value": ""
		}
	]
}
